rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.isActive == true;
    }

    // 大会の編集権限（events:write）。オーナーは常に可能（サーバー側の requireAdminRequest と同じ判定）。
    function canEditEvents() {
      let adminData = get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data;
      return isAdmin()
        && (adminData.get("role", "") == "owner"
          || "events:write" in adminData.get("permissions", []));
    }

    // エントリーリストの公開設定（entryListPublic）を変更・有効化できるのは、
    // 大会の編集権限がある管理者だけ。エントリー自体の読み取りは一般に許可しない
    // （公開用のリストはサーバーが必要な 3 項目だけを取り出して返す）。
    function entryListPublicCreateAllowed() {
      return request.resource.data.get("entryListPublic", false) != true || canEditEvents();
    }

    // 未設定は非公開（false）と同じに扱う。既存の大会をフォームで保存し直したときに
    // false が書き込まれるだけなら、値は変わらないため権限は問わない。
    function entryListPublicUpdateAllowed() {
      return request.resource.data.get("entryListPublic", false)
          == resource.data.get("entryListPublic", false)
        || canEditEvents();
    }

    function publicInquiryCreateAllowed(inquiryId) {
      let data = request.resource.data;

      return data.keys().hasOnly([
          "inquiryId",
          "name",
          "email",
          "phone",
          "inquiryType",
          "message",
          "status",
          "adminNotified",
          "userNotified",
          "emailError",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasAll([
          "name",
          "email",
          "message",
          "createdAt",
        ])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 100
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 200
        && (data.phone == null || (data.phone is string && data.phone.size() <= 40))
        && data.inquiryType in ["entry", "payment", "event", "other", ""]
        && data.message is string
        && data.message.size() >= 1
        && data.message.size() <= 5000
        && data.createdAt == request.time
        && (!data.keys().hasAny(["updatedAt"]) || data.updatedAt == request.time);
    }

    // エントリーの保存・料金の確定・支払状態の更新は、サーバー（API ルート）が
    // Firebase Admin SDK で行う（src/lib/entries/entry-server.ts）。Admin SDK は
    // このルールの対象外のため、ここでは一般ユーザーからの直接の読み書きをすべて拒否する。
    //
    // 管理者がブラウザから直接更新できるのは、受付・計量・ゼッケンなど当日運営の項目だけ。
    // 支払状態・金額・申込内容・入金確認の記録は、管理者であっても直接は変更できない
    // （入金の記録は /api/admin/entries/confirm-payment を通す）。
    function adminEntryUpdateAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "receptionStatus",
        "checkedInAt",
        "weighInStatus",
        "weighInAt",
        "bibNumber",
        "bracketPosition",
        "updatedAt"
      ]);
    }

    match /events/{eventId} {
      allow read: if isAdmin()
        || (
          resource.data.status == "published"
          && (!resource.data.keys().hasAny(["deletedAt"]) || resource.data.deletedAt == null)
        );
      allow create: if isAdmin() && entryListPublicCreateAllowed();
      allow update: if isAdmin() && entryListPublicUpdateAllowed();
      allow delete: if isAdmin();
    }

    match /eventCategories/{categoryId} {
      allow read: if isAdmin()
        || get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.status == "published";
      allow write: if false;
    }

    // 変更履歴・入金や返金の記録がある申込、支払済みの申込は削除できない
    // （取消は「申込全体のキャンセル」で状態を残す）。
    function adminEntryDeleteAllowed() {
      return resource.data.paymentStatus != "paid"
        && resource.data.get("revision", 0) == 0
        && resource.data.get("accountingInitialized", false) != true;
    }

    match /entries/{entryId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if isAdmin() && adminEntryUpdateAllowed();
      allow delete: if isAdmin() && adminEntryDeleteAllowed();

      // 金額の記録（台帳）と変更履歴。サーバー（Admin SDK）だけが追記し、
      // 管理者を含め、ブラウザからは作成・上書き・削除できない。
      match /ledger/{recordId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      match /history/{recordId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /adminUsers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // 受付メール・完了メールの履歴はサーバー（Admin SDK）が書き込む。
    match /emailLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /inquiries/{inquiryId} {
      allow read: if isAdmin();
      allow create: if publicInquiryCreateAllowed(inquiryId);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "status",
          "updatedAt",
          "replyCount",
          "lastReplyAt",
          "lastReplySubject",
          "lastReplyBodyPreview",
          "lastReplyRecipientEmail",
          "lastReplyByUid",
          "lastReplyByEmail"
        ])
        && request.resource.data.status in ["unhandled", "in_progress", "resolved"]
        && request.resource.data.updatedAt is timestamp
        && (
          !request.resource.data.keys().hasAny(["replyCount"])
          || request.resource.data.replyCount is number
        )
        && (
          !request.resource.data.keys().hasAny(["lastReplyAt"])
          || request.resource.data.lastReplyAt is timestamp
        )
        && (
          !request.resource.data.keys().hasAny(["lastReplySubject"])
          || request.resource.data.lastReplySubject is string
        )
        && (
          !request.resource.data.keys().hasAny(["lastReplyBodyPreview"])
          || request.resource.data.lastReplyBodyPreview is string
        )
        && (
          !request.resource.data.keys().hasAny(["lastReplyRecipientEmail"])
          || request.resource.data.lastReplyRecipientEmail is string
        )
        && (
          !request.resource.data.keys().hasAny(["lastReplyByUid"])
          || request.resource.data.lastReplyByUid is string
        )
        && (
          !request.resource.data.keys().hasAny(["lastReplyByEmail"])
          || request.resource.data.lastReplyByEmail is string
        );
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
